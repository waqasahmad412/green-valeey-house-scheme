{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Registered resident or prospective homebuyer profile with isolated PII access.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Firebase Auth UID of the user",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "fullName": {
          "type": "string",
          "description": "Full display name of the user",
          "minLength": 1,
          "maxLength": 100
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "Verified email address",
          "maxLength": 150
        },
        "phone": {
          "type": "string",
          "description": "Contact phone number",
          "maxLength": 30
        },
        "role": {
          "type": "string",
          "description": "User authorization role",
          "enum": ["resident", "admin"]
        },
        "status": {
          "type": "string",
          "description": "Account status",
          "enum": ["active", "suspended"]
        },
        "favoriteHouseIds": {
          "type": "array",
          "description": "Bounded list of saved house IDs (up to 20)"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of creation"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of last update"
        }
      },
      "required": ["uid", "fullName", "email", "phone", "role", "status", "favoriteHouseIds", "createdAt", "updatedAt"]
    },
    "AdminRecord": {
      "title": "AdminRecord",
      "description": "Trusted administrator registry document keyed by UID.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "email": {
          "type": "string",
          "format": "email",
          "maxLength": 150
        },
        "grantedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "email", "grantedAt"]
    },
    "House": {
      "title": "House",
      "description": "Residential property listing in Green Valley Residencia.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "houseNumber": {
          "type": "string",
          "description": "Plot or house number e.g. GV-101",
          "minLength": 2,
          "maxLength": 30
        },
        "title": {
          "type": "string",
          "description": "Architectural title of the residence",
          "minLength": 3,
          "maxLength": 120
        },
        "houseType": {
          "type": "string",
          "enum": ["3 Marla", "5 Marla", "10 Marla", "1 Kanal"]
        },
        "plotSize": {
          "type": "string",
          "enum": ["3 Marla", "5 Marla", "10 Marla", "1 Kanal"]
        },
        "bedrooms": {
          "type": "number",
          "description": "Number of bedrooms"
        },
        "bathrooms": {
          "type": "number",
          "description": "Number of bathrooms"
        },
        "kitchenDetails": {
          "type": "string",
          "description": "Kitchen layout and finish details",
          "maxLength": 300
        },
        "coveredAreaSqFt": {
          "type": "number",
          "description": "Covered area in square feet"
        },
        "pricePKR": {
          "type": "number",
          "description": "Listing price in PKR"
        },
        "availability": {
          "type": "string",
          "enum": ["Available", "Reserved", "Sold"]
        },
        "sector": {
          "type": "string",
          "maxLength": 60
        },
        "street": {
          "type": "string",
          "maxLength": 60
        },
        "description": {
          "type": "string",
          "maxLength": 2000
        },
        "floorPlanSummary": {
          "type": "string",
          "maxLength": 500
        },
        "images": {
          "type": "array",
          "description": "Bounded list of image URLs (up to 6)"
        },
        "coordinates3D": {
          "type": "object",
          "description": "X and Z position in the 3D colony layout"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "houseNumber",
        "title",
        "houseType",
        "plotSize",
        "bedrooms",
        "bathrooms",
        "kitchenDetails",
        "coveredAreaSqFt",
        "pricePKR",
        "availability",
        "sector",
        "street",
        "description",
        "floorPlanSummary",
        "images",
        "createdAt",
        "updatedAt"
      ]
    },
    "Park": {
      "title": "Park",
      "description": "Landscaped park or botanical garden in the society.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
