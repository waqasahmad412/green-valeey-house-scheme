  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "User profile document with strict owner/admin read and write isolation."
    },
    "/admins/{adminId}": {
      "schema": "AdminRecord",
      "description": "Trusted administrator lookup table."
    },
    "/houses/{houseId}": {
      "schema": "House",
      "description": "Publicly readable residential house inventory managed by administrators."
    },
    "/parks/{parkId}": {
      "schema": "Park",
      "description": "Publicly readable landscaped parks and botanical gardens."
    },
    "/amenities/{amenityId}": {
      "schema": "Amenity",
      "description": "Publicly readable society facilities including gym and security checkpoints."
    },
    "/houseInquiries/{inquiryId}": {
      "schema": "HouseInquiry",
      "description": "Private buyer inquiries accessible only to the submitting user and administrators."
    },
    "/visitBookings/{bookingId}": {
      "schema": "VisitBooking",
      "description": "Private property visit appointments accessible only to the submitting user and administrators."
    },
    "/gymInquiries/{inquiryId}": {
      "schema": "GymInquiry",
      "description": "Private gym membership requests accessible only to the submitting user and administrators."
    },
    "/visitorLogs/{logId}": {
      "schema": "VisitorLog",
      "description": "Security gate visitor entry logs accessible only to the resident who registered the visitor and administrators."
    },
    "/announcements/{announcementId}": {
      "schema": "Announcement",
      "description": "Community and security notices readable by residents and visitors, managed by administrators."
    },
    "/gallery/{galleryId}": {
      "schema": "GalleryItem",
      "description": "Architectural and community photo gallery items."
    },
    "/contactMessages/{messageId}": {
      "schema": "ContactMessage",
      "description": "Contact inquiries accessible only to the sender and administrators."
    },
    "/societySettings/{settingId}": {
      "schema": "SocietySettings",
      "description": "Global society statistics and contact configuration."
    }
  }
}
