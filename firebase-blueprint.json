        },
        "name": {
          "type": "string",
          "minLength": 2,
          "maxLength": 120
        },
        "category": {
          "type": "string",
          "enum": ["Gym", "Security", "Community", "Recreation"]
        },
        "openingHours": {
          "type": "string",
          "maxLength": 100
        },
        "description": {
          "type": "string",
          "maxLength": 1500
        },
        "highlights": {
          "type": "array",
          "description": "Bounded list of facility features (up to 10)"
        },
        "imageUrl": {
          "type": "string",
          "maxLength": 500
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
