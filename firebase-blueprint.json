        "name": {
          "type": "string",
          "minLength": 2,
          "maxLength": 120
        },
        "sector": {
          "type": "string",
          "maxLength": 80
        },
        "areaSize": {
          "type": "string",
          "maxLength": 60
        },
        "openingHours": {
          "type": "string",
          "maxLength": 100
        },
        "description": {
          "type": "string",
          "maxLength": 1500
        },
        "facilities": {
          "type": "array",
          "description": "Bounded list of park facilities (up to 10)"
        },
        "imageUrl": {
          "type": "string",
          "maxLength": 500
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["id", "name", "sector", "areaSize", "openingHours", "description", "facilities", "imageUrl", "updatedAt"]
    },
    "Amenity": {
